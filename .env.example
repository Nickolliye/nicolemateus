# Supabase Project Configuration
# Obtenha esses valores em: https://supabase.com/dashboard > Settings > API

# URL publica do projeto Supabase (ex: https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Chave anonima publica (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Base URL para GitHub Pages (ex: /nome-do-repositorio/)
# Deixe como / para desenvolvimento local ou dominio proprio
VITE_BASE_URL=/
